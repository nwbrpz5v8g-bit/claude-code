# Postgres 14+ (the btree_gist extension must be available)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/carwash"

# 32+ random characters; signs session cookies. Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-32-plus-random-characters-xx"

# Dev-only passwordless login (any email). Refused when NODE_ENV=production.
AUTH_DEV_LOGIN="true"

# Public base URL, used for payment redirect URLs.
APP_URL="http://localhost:3000"

# Leave empty to use the fake in-app checkout. Set both to use Stripe Checkout.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Bearer token for /api/internal/cron/* endpoints.
CRON_SECRET="replace-with-a-random-token"
